# TokLens — example nginx server block
server {
    listen 443 ssl http2;
    server_name toklens.example;
    root /var/www/toklens/public;      # <- the PUBLIC folder only
    index index.php;

    ssl_certificate     /etc/letsencrypt/live/toklens.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/toklens.example/privkey.pem;

    server_tokens off;
    client_max_body_size 1m;

    location ~ /\.(?!well-known) { deny all; }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_buffering off;          # needed for video streaming
        fastcgi_read_timeout 300;
    }

    location ~ \.php$ { return 404; }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/xml;
}

server {
    listen 80;
    server_name toklens.example;
    return 301 https://$host$request_uri;
}
